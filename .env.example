# Tempolens example configuration. Copy to .env (gitignored) and edit.
# Every variable and its default is documented in README.md (Configuration).
# Values below are placeholders; never commit real secrets.
# Tempolens reads only its process environment, not this file: load it with
# a compose `env_file` or `set -a; . ./.env; set +a`. (`docker run --env-file`
# keeps quotes literally, so drop them there.)

# Temporal frontend (gRPC).
TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_TLS_CA=/etc/tempolens/tls/ca.pem
# TEMPORAL_TLS_CERT=/etc/tempolens/tls/client.pem
# TEMPORAL_TLS_KEY=/etc/tempolens/tls/client-key.pem
# TEMPORAL_TLS_SERVER_NAME=temporal.example.com

TEMPOLENS_PORT=8080
TEMPOLENS_PUBLIC_ORIGIN=https://tempolens.example.com
TEMPOLENS_DEFAULT_NAMESPACE=default

# --- Login (OIDC, e.g. Dex) ---
TEMPOLENS_AUTH_PROVIDER_URL=https://dex.example.com
TEMPOLENS_AUTH_CLIENT_ID=tempolens
TEMPOLENS_AUTH_CLIENT_SECRET=change-me
TEMPOLENS_AUTH_CALLBACK_URL=https://tempolens.example.com/auth/sso/callback
# Claim groups are matched exactly; inner spaces are kept.
TEMPOLENS_AUTH_ADMIN_GROUPS="acme:Platform Admins"
TEMPOLENS_AUTH_WRITE_GROUPS="acme:Platform Team"
# Optional: when set, users in none of the groups are refused.
# TEMPOLENS_AUTH_READ_GROUPS=acme:Engineering
# Base64 32-byte keys, first one seals: openssl rand -base64 32
TEMPOLENS_SESSION_KEYS=replace-with-openssl-rand-base64-32
TEMPOLENS_SESSION_TTL=8h

# --- Local development without login (never in production) ---
# TEMPOLENS_AUTH_DISABLED=true
# TEMPOLENS_AUTH_DISABLED_ROLE=read

# --- Guards ---
# Namespaces that can never be deleted (default and temporal-system always are).
TEMPOLENS_PROTECTED_NAMESPACES=default
# TEMPOLENS_DISABLE_WRITE_ACTIONS=false
# TEMPOLENS_WORKFLOW_DELETE_DISABLED=false
# TEMPOLENS_NAMESPACE_ACTIONS_DISABLED=false
# TEMPOLENS_SEARCH_ATTRIBUTE_ACTIONS_DISABLED=false

# --- Codec server (called by the browser) ---
# TEMPOLENS_CODEC_ENDPOINT=https://codec.example.com

TEMPOLENS_LOG_LEVEL=info
